# Environment variables configuration

# 1. Localhost development using SQLite (default):
DATABASE_URL=sqlite:///./craft_products.db

# 2. Production or cloud development using MySQL:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database_name>
# Example:
# DATABASE_URL=mysql+pymysql://root:password123@localhost:3306/craft_gi_db

APP_NAME="Craft & GI Product Verification API"
DEBUG=True
